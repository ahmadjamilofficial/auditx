# Copy this file to .env and fill in your values.
# ─── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here       # alias kept for backwards-compat
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # NEVER expose client-side

# ─── AI Providers (at least one required) ─────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key                # primary (Google Gemini)
GEMINI_MODEL=gemini-2.0-flash-exp                # override model (optional)
LOVABLE_API_KEY=your-lovable-key                 # fallback 1 (Lovable Cloud hosting)
OPENROUTER_API_KEY=your-openrouter-key           # fallback 2
OPENROUTER_MODEL=openai/gpt-4o                   # override reasoning model (optional)
GROQ_API_KEY=your-groq-key                       # fallback 3
GROQ_MODEL=openai/gpt-oss-20b

# ─── App URL ──────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:8080

# ─── Autonomous Agent — Google Sheets OAuth ───────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Redirect URI to register in Google Cloud Console:
#   {VITE_APP_URL}/api/auth/google/callback

# ─── Autonomous Agent — OneDrive / Microsoft Graph OAuth ──────────────────────
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common                       # or your tenant UUID
# Redirect URI to register in Azure Portal:
#   {VITE_APP_URL}/api/auth/onedrive/callback

# ─── Email Ingestion Webhook ──────────────────────────────────────────────────
EMAIL_WEBHOOK_SECRET=change-me-to-something-random
# Point your email relay (Mailgun, Postmark, SendGrid) to:
#   POST {VITE_APP_URL}/api/webhooks/email?org_id=<ORG_UUID>&secret=<EMAIL_WEBHOOK_SECRET>

# ─── Email Delivery (notifications) ──────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@auditx.app

# ─── Tool approval secret (AI SDK STOP-tier gates) ────────────────────────────
TOOL_APPROVAL_SECRET=auditx-tool-approval        # change in production

# ─── Kelviq Payment (billing) ──────────────────────────────────────────────────
KELVIQ_WEBHOOK_SECRET=your-kelviq-webhook-secret
KELVIQ_CHECKOUT_URL=https://www.kelviq.com/buy/ac42e10b-db2e-44ca-b212-6d4f0429b6e3

# ─── Stripe (billing — optional, deprecated in favor of Kelviq) ────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
